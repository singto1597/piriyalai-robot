void Can1()//กระป๋อง1
{  
  
  ForwardSpeedTime(60,200);
  TracJCSpeed(); //เดินยาวเส้นแยก 
  TurnRight(); // เลี้ยวขวา
  TracJC(); //เส้นแยก
  TracJC(); //เส้นแยก
  ForwardSpeedTime(60,70); //เดินหน้าเล็กน้อย
  GripDown(); // วางกระป๋อง
  Put(); // กางมือ
  ServoGripUp(); // ยกมือ
  TracJCBack(); // ถอย 1 แยก
  TracJCBack(); // ถอย 1 แยก
  TurnRight(); // เลี้ยวขวา
  TracJC(); //เส้นแยก
  ForwardSpeedTime(60,30); //เดินหน้าเล็กน้อย
}

